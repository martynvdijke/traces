<div class="columns">
  {% assign url = trml.plugin_settings.custom_fields_values.url %}
  <div class="column">
    <div class="layout layout--col gap--xsmall">
      {% if events.size == 0 %}
        <div class="item">
          <div class="content">
            <span class="value value--xsmall">No events this month</span>
          </div>
        </div>
      {% else %}
        <div class="item">
          <div class="content">
            <span class="label label--small">{{ month }} in history</span>
            <span class="value value--xsmall">{{ stats.event_count }} events{% if stats.favorite_count > 0 %} · {{ stats.favorite_count }}★{% endif %}</span>
          </div>
        </div>
        <div class="divider--h"></div>
        {% for event in events %}
          {% if forloop.index <= 4 %}
            <div class="item">
              <div class="content">
                <span class="value value--xxsmall">{% if event.is_favorite %}★ {% endif %}{{ event.title }}</span>
                <span class="label label--small">{{ event.year }}{% if event.location %} · {{ event.location }}{% endif %}</span>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <div class="column">
    <div class="layout layout--col gap--xsmall">
      {% if stats.media.size > 0 %}
        <div class="item">
          <div class="content">
            <span class="label label--small">Media</span>
          </div>
        </div>
        <div class="divider--h"></div>
        {% for m in stats.media %}
          <div class="item">
            <div class="content">
              <span class="value value--xxsmall">{{ m.type | capitalize }}</span>
            </div>
            <div class="content">
              <span class="label label--small">{{ m.count }}</span>
            </div>
          </div>
        {% endfor %}
      {% endif %}
      {% if stats.top_persons.size > 0 %}
        <div class="divider--h"></div>
        <div class="item">
          <div class="content">
            <span class="label label--small">People
              {%- for p in stats.top_persons %} · {{ p.name }} ({{ p.count }}){% endfor -%}
            </span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<div class="title_bar">
  {% if url %}<img class="image" src="{{ url }}/static/logo.svg" />{% endif %}
  <span class="title">TRACES · {{ month }}</span>
</div>
