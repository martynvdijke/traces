<div class="layout layout--col gap--xsmall">
  {% assign url = trml.plugin_settings.custom_fields_values.url %}
  {% if events.size == 0 %}
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No events this month</span>
        <span class="label label--small">New highlights appear as the timeline grows</span>
      </div>
    </div>
  {% else %}
    <div class="item">
      <div class="content">
        <span class="label label--small">{{ month }} in history</span>
        <span class="value value--small">{{ stats.event_count }} events{% if stats.favorite_count > 0 %} · {{ stats.favorite_count }} favorites{% endif %}</span>
      </div>
    </div>
    <div class="divider--h"></div>

    {% for event in events %}
      {% if event.is_favorite %}
        <div class="item">
          <div class="content">
            <span class="value value--xxsmall">★ {{ event.title }}</span>
            <span class="label label--small">{{ event.year }}{% if event.location %} · {{ event.location }}{% endif %}{% if event.person_name %} · {{ event.person_name }}{% endif %}</span>
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% for event in events %}
      {% unless event.is_favorite %}
        <div class="item">
          <div class="content">
            <span class="value value--xxsmall">{{ event.title }}</span>
            <span class="label label--small">{{ event.year }}{% if event.location %} · {{ event.location }}{% endif %}{% if event.person_name %} · {{ event.person_name }}{% endif %}</span>
          </div>
        </div>
      {% endunless %}
    {% endfor %}

    {% if stats.media.size > 0 %}
      <div class="divider--h"></div>
      <div class="item">
        <div class="content">
          <span class="label label--small">Media breakdown</span>
        </div>
      </div>
      <div class="grid grid--cols-2 gap--xsmall">
        {% for m in stats.media %}
          <div class="item">
            <div class="content">
              <span class="value value--xxsmall">{{ m.type | capitalize }}</span>
            </div>
            <div class="content">
              <span class="label label--small">{{ m.count }}</span>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if stats.top_tags.size > 0 %}
      <div class="divider--h"></div>
      <div class="item">
        <div class="content">
          <span class="label label--small">Top tags
            {%- for t in stats.top_tags %} · {{ t.tag }} ({{ t.count }}){% endfor -%}
          </span>
        </div>
      </div>
    {% endif %}
  {% endif %}
</div>

<div class="title_bar">
  {% if url %}<img class="image" src="{{ url }}/static/logo.svg" />{% endif %}
  <span class="title">TRACES · {{ month }} highlights</span>
</div>
