<div class="layout layout--col layout--stretch gap--xsmall">
  {% assign url = trml.plugin_settings.custom_fields_values.url %}
  {% if events.size == 0 %}
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No events this month</span>
      </div>
    </div>
  {% else %}
    <div class="item">
      <div class="content">
        <span class="label label--small">{{ month }} in history</span>
        <span class="value value--xxsmall">{{ stats.event_count }} events{% if stats.favorite_count > 0 %} · {{ stats.favorite_count }}★{% endif %}</span>
      </div>
    </div>
    <div class="divider--h"></div>
    {% for event in events %}
      {% if forloop.index <= 4 %}
        <div class="item">
          <div class="content">
            <span class="value value--xxsmall">{% if event.is_favorite %}★ {% endif %}{{ event.title }}</span>
            <span class="label label--small">{{ event.year }}</span>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  {% endif %}
</div>

<div class="title_bar">
  {% if url %}<img class="image" src="{{ url }}/static/logo.svg" />{% endif %}
  <span class="title">TRACES · {{ month }}</span>
</div>
